{
  "schemaVersion": 1,
  "taxonomyVersion": 2,
  "description": "Domain -> Area -> Technology. Deterministic: a technology is detected from GitHub topics, repository name tokens and description phrases only. Topic aliases adapted from github/explore (CC BY 4.0, see THIRD_PARTY.md). The v1 category classifier is unchanged; this layer sits on top of it.",
  "acceptance": {
    "weights": {
      "topic": 3,
      "name": 2,
      "description": 1
    },
    "minScore": 3,
    "note": "topic alone is accepted; name alone (2) is not; name + description (3) is; description alone (1) never is"
  },
  "facets": {
    "ageBands": [
      {
        "slug": "emerging",
        "maxAgeDays": 365
      },
      {
        "slug": "growing",
        "maxAgeDays": 1095
      },
      {
        "slug": "established",
        "maxAgeDays": 2920
      },
      {
        "slug": "mature",
        "maxAgeDays": null
      }
    ],
    "learningContextId": "educational-content",
    "learning": {
      "note": "A repository is learning/list content (not software to evaluate) when its evidence reaches minScore. The v1 educational-content context also counts. Adapted vocabulary: the v1 context signal, github/explore topic aliases (CC BY 4.0) and ecosyste-ms/oss-taxonomy (CC0) education terms.",
      "weights": {
        "topic": 2,
        "name": 2,
        "description": 1,
        "descriptionMax": 2
      },
      "minScore": 2,

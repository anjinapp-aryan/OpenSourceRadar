{
  "name": "opensource-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenSource Radar - authenticated GitHub data foundation (Phase 1)",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke:graphql": "tsx scripts/smoke/graphql.ts",
    "smoke:search": "tsx scripts/smoke/search.ts",
    "smoke:star-history": "tsx scripts/smoke/star-history.ts",
    "smoke:rate-limit": "tsx scripts/smoke/rate-limit.ts",
    "smoke": "tsx scripts/smoke/run-all.ts",
    "budget": "tsx scripts/budget.ts",
    "collect": "tsx scripts/collect/index.ts",
    "gen:categories": "node scripts/gen-category-config.mjs",
    "gen:classification": "node scripts/gen-classification-config.mjs",
    "classify": "tsx scripts/classify/index.ts",
    "track": "tsx scripts/track/index.ts",
    "momentum": "tsx scripts/momentum/index.ts",
    "pipeline": "tsx scripts/pipeline/index.ts",
    "pipeline:preflight": "tsx scripts/pipeline/index.ts preflight",
    "pipeline:validate": "tsx scripts/pipeline/index.ts validate",
    "pipeline:publish": "tsx scripts/pipeline/index.ts publish",
    "pipeline:summary": "tsx scripts/pipeline/index.ts summary",
    "pipeline:verify": "tsx scripts/pipeline/index.ts verify",

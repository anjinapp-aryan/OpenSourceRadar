    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "axe-core": "^4.13.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
